#!/data/data/com.termux/files/usr/bin/bash
# AF Termux (ADB Fastboot Termux) v1.1.0
# By lptech22 — https://github.com/lptech22/af-termux
# Flash partisi HANYA di modul Advanced (konfirmasi ganda). Tidak ada erase.

AF_VERSION="1.1.0"
AF_REPO="lptech22/af-termux"
AF_RAW="https://raw.githubusercontent.com/$AF_REPO/main"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

GREEN="\033[32m"; RED="\033[31m"; YELLOW="\033[33m"; CYAN="\033[36m"; BOLD="\033[1m"; DIM="\033[2m"; RESET="\033[0m"

# ---------- backend ----------
if command -v termux-adb >/dev/null 2>&1; then ADB="termux-adb"; elif command -v adb >/dev/null 2>&1; then ADB="adb"; else ADB=""; fi
if command -v termux-fastboot >/dev/null 2>&1; then FB="termux-fastboot"; elif command -v fastboot >/dev/null 2>&1; then FB="fastboot"; else FB=""; fi

MODE=""; SERIAL=""
trap 'echo; err "Dibatalkan."; exit 130' INT

# ---------- helper ----------
ask()     { read -r "$@" || { echo; err "Input ditutup."; exit 0; }; }
pause()   { echo; ask -p "Tekan Enter untuk lanjut..." _; }
confirm() { local c; ask -p "$1 [y/N]: " c; [[ "$c" =~ ^[Yy]$ ]]; }
expand()  { local p="$1"; echo "${p/#\~/$HOME}"; }
ok()      { echo -e "${GREEN}✔${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET} $*"; }
err()     { echo -e "${RED}✖${RESET} $*"; }
hr()      { echo -e "${DIM}────────────────────────────────────────────${RESET}"; }
need_adb() { [ -n "$ADB" ] || { err "Backend ADB tidak ada. Jalankan ulang installer."; return 1; }; }
need_fb()  { [ -n "$FB" ]  || { err "Backend Fastboot tidak ada. Jalankan ulang installer."; return 1; }; }
outdir()   { local d; if [ -d "$HOME/storage/shared" ]; then d="$HOME/storage/shared/AF"; else d="$HOME/af-output"; fi; mkdir -p "$d" 2>/dev/null && echo "$d"; }
stamp()    { date +%Y%m%d-%H%M%S; }

# ---------- deteksi mode (refresh tiap layar digambar) ----------
detect_mode() {
  MODE=""; SERIAL=""
  if [ -n "$FB" ] && [ -n "$($FB devices 2>/dev/null | grep .)" ]; then MODE="fastboot"; return 0; fi
  [ -n "$ADB" ] || return 0
  local line st
  line=$($ADB devices 2>/dev/null | awk 'NR>1 && NF>1 {print $1" "$2}' | head -1)
  st=${line#* }; SERIAL=${line%% *}
  case "$st" in
    device)       MODE="adb" ;;
    sideload)     MODE="sideload" ;;
    recovery)     MODE="recovery" ;;
    unauthorized) MODE="unauthorized" ;;
    offline)      MODE="offline" ;;
    *)            SERIAL="" ;;
  esac
}

badge() {
  case "$MODE" in
    adb)          echo -e "${GREEN}● ADB terhubung${RESET}" ;;
    recovery)     echo -e "${CYAN}● Recovery (via ADB)${RESET}" ;;
    sideload)     echo -e "${CYAN}● Sideload${RESET}" ;;
    fastboot)     echo -e "${YELLOW}● Fastboot${RESET}" ;;
    unauthorized) echo -e "${RED}● ADB — setujui dialog izin${RESET}" ;;
    offline)      echo -e "${RED}● ADB — offline${RESET}" ;;
    *)            echo -e "${RED}○ Tidak ada perangkat${RESET}" ;;
  esac
}

banner() {
  clear
  echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  echo -e " ${BOLD}AF TERMUX${RESET} ${YELLOW}v$AF_VERSION${RESET} ${DIM}· ADB & Fastboot · lptech22${RESET}"
  echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  detect_mode
  echo -e " Mode: $(badge)"
  if [ "$MODE" = adb ]; then
    local m; m=$($ADB shell getprop ro.product.model 2>/dev/null | tr -d '\r')
    [ -n "$m" ] && echo -e " ${DIM}Unit: $m${RESET}"
  fi
  echo
  [ -n "$1" ] && { echo -e "${BOLD}▶ $1${RESET}"; echo; }
}

adb_ready() {
  need_adb || return 1
  local i devs n
  for i in 1 2 3; do
    devs=$($ADB devices 2>/dev/null | awk 'NR>1 && $2=="device"{print $1}')
    n=$(printf '%s\n' "$devs" | grep -c . || true)
    if [ "$n" -eq 1 ]; then return 0; fi
    if [ "$n" -gt 1 ]; then err "Ada $n perangkat ADB. Cabut salah satu."; return 1; fi
    [ "$i" -eq 3 ] && break
    warn "Belum siap (percobaan $i/3). Setujui dialog 'Izinkan debugging USB'"
    warn "dan/atau izin USB untuk Termux bila muncul di layar."
    ask -p "Enter = cek ulang (Ctrl+C batal)... " _ || return 1
  done
  err "Perangkat ADB belum siap. Coba Koneksi > Diagnosis USB."
  return 1
}

wait_mode() { # wait_mode <mode> <timeout-detik>
  local want="$1" t="${2:-60}" i
  for ((i=0; i<t; i++)); do
    detect_mode
    [ "$MODE" = "$want" ] && return 0
    sleep 1; printf "."
  done
  echo; return 1
}

# ---------- 1. Perangkat ----------
info_adb() {
  adb_ready || return
  local kv mem sto scr bat lvl stt s
  kv() { printf " ${BOLD}%-12s${RESET} %s\n" "$1" "$2"; }
  kv "Merk/Model" "$($ADB shell getprop ro.product.manufacturer 2>/dev/null | tr -d '\r') $($ADB shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
  kv "Perangkat"   "$($ADB shell getprop ro.product.device 2>/dev/null | tr -d '\r')"
  kv "Android"     "$($ADB shell getprop ro.build.version.release 2>/dev/null | tr -d '\r') (SDK $($ADB shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r'))"
  kv "Build"       "$($ADB shell getprop ro.build.display.id 2>/dev/null | tr -d '\r')"
  kv "ABI"         "$($ADB shell getprop ro.product.cpu.abi 2>/dev/null | tr -d '\r')"
  kv "Patch"       "$($ADB shell getprop ro.build.version.security_patch 2>/dev/null | tr -d '\r')"
  mem=$($ADB shell cat /proc/meminfo 2>/dev/null | awk '/MemTotal/{printf "%.1f GB", $2/1048576}')
  sto=$($ADB shell df -h /data 2>/dev/null | awk 'NR==2{print $4" bebas / "$2}')
  scr=$($ADB shell wm size 2>/dev/null | tr -d '\r' | awk '{print $3}')
  bat=$($ADB shell dumpsys battery 2>/dev/null | tr -d '\r')
  lvl=$(awk '/level:/{print $2}' <<<"$bat")
  stt=$(awk '/status:/{print $2}' <<<"$bat")
  case "$stt" in 2) s="mengisi daya";; 5) s="penuh";; 3) s="tidak mengisi";; *) s="-";; esac
  kv "RAM" "${mem:--}"; kv "Storage" "${sto:--}"; kv "Layar" "${scr:--}"
  kv "Baterai" "${lvl:--}% ($s)"
  kv "Serial" "$SERIAL"
  hr
  echo -e " ${DIM}Tip: cek mode lain via menu Reboot. Fastboot terbatas info.${RESET}"
}

info_fastboot() {
  need_fb || return
  detect_mode; [ "$MODE" = fastboot ] || { warn "Tidak ada perangkat Fastboot (masuk mode bootloader dulu)."; return; }
  local v line
  for v in product serialno current-slot unlocked secure version-bootloader; do
    line=$($FB getvar "$v" 2>&1 | tr -d '\r' | sed 's/^[[:space:]]*(bootloader)[[:space:]]*//' | grep -m1 "^$v:")
    printf " ${BOLD}%-18s${RESET} %s\n" "$v" "${line#*: }"
  done
}

list_partisi() {
  adb_ready || return
  echo "Partisi (by-name):"
  $ADB shell "ls -l /dev/block/by-name/ 2>/dev/null || ls -l /dev/block/bootdevice/by-name/ 2>/dev/null" | tr -d '\r' | head -60
  warn "Kosong = skema by-name tidak tersedia di perangkat ini."
}

menu_perangkat() {
  while true; do
    banner "Perangkat"
    echo " 1) Info lengkap (ADB)"
    echo " 2) Info (Fastboot)"
    echo " 3) Daftar partisi (ADB)"
    echo " R) Refresh deteksi"
    echo " 0) Kembali"
    echo
    ask -p "Pilih: " c
    case "$c" in
      1) info_adb; pause ;;
      2) info_fastboot; pause ;;
      3) list_partisi; pause ;;
      r|R) ok "Status diperbarui." ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

# ---------- file picker (tanpa ketik path) ----------
pick_local() { # $1=start, $2=file|folder → hasil: LSEL
  local dir="${1:-$PWD}" mode="${2:-file}" c sel n hint
  while true; do
    [ -d "$dir" ] || dir="$HOME"
    local items=() ; n=1
    echo; echo -e "${BOLD}📁 Lokal:${RESET} $dir"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      items+=("$f"); printf " %2d) %s\n" "$n" "$f"; n=$((n+1))
    done < <(ls -1Ap "$dir" 2>/dev/null | head -200)
    [ "${#items[@]}" -eq 0 ] && warn "(folder kosong)"
    hint=" 0) ../ naik   k) ketik path   q) batal"
    [ "$mode" = folder ] && hint="$hint   ${GREEN}p) pakai folder ini${RESET}"
    echo -e "$hint"
    ask -p "Pilih: " c
    case "$c" in
      0) dir=$(dirname "$dir") ;;
      q|Q) return 1 ;;
      k|K) ask -e -p "Path: " dir; dir=$(expand "$dir") ;;
      p|P) [ "$mode" = folder ] && { LSEL="$dir"; return 0; } ;;
      *)
        if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le "${#items[@]}" ]; then
          sel="${items[$((c-1))]}"
          case "$sel" in
            */) dir="${dir%/}/${sel%/}" ;;
            *)  LSEL="${dir%/}/$sel"; return 0 ;;
          esac
        else err "Pilihan tidak valid."; fi
        ;;
    esac
  done
}

pick_remote() { # $1=start, $2=file|folder → hasil: RSEL
  local dir="${1:-/sdcard}" mode="${2:-file}" c sel n hint it
  while true; do
    adb_ready || return 1
    local items=() ; n=1
    echo; echo -e "${BOLD}📱 Perangkat:${RESET} $dir"
    mapfile -t items < <($ADB shell "ls -1p '$dir'" 2>/dev/null | tr -d '\r' | sed '/^$/d' | head -200)
    if [ "${#items[@]}" -eq 0 ]; then warn "(kosong / tidak terbaca)"; fi
    for it in "${items[@]}"; do printf " %2d) %s\n" "$n" "$it"; n=$((n+1)); done
    hint=" 0) ../ naik   k) ketik path   q) batal"
    [ "$mode" = folder ] && hint="$hint   ${GREEN}p) pakai folder ini${RESET}"
    echo -e "$hint"
    ask -p "Pilih: " c
    case "$c" in
      0) dir=$(dirname "$dir") ;;
      q|Q) return 1 ;;
      k|K) ask -e -p "Path di perangkat: " dir ;;
      p|P) [ "$mode" = folder ] && { RSEL="$dir"; return 0; } ;;
      *)
        if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le "${#items[@]}" ]; then
          sel="${items[$((c-1))]}"
          case "$sel" in
            */) dir="${dir%/}/${sel%/}" ;;
            *)  RSEL="${dir%/}/$sel"; return 0 ;;
          esac
        else err "Pilihan tidak valid."; fi
        ;;
    esac
  done
}

dl_dir() { local d="$HOME/storage/shared/Download"; [ -d "$d" ] && echo "$d" || echo "$PWD"; }

# ---------- 2. File & APK ----------
do_push() {
  need_adb || return
  local base="$HOME/storage/shared"; [ -d "$base" ] || base="$HOME"
  pick_local "$base" file || { warn "Batal."; return; }
  local src="$LSEL"
  pick_remote "/sdcard/" folder || { warn "Batal."; return; }
  $ADB push "$src" "$RSEL"
}

do_pull() {
  need_adb || return
  pick_remote "/sdcard" file || { warn "Batal."; return; }
  local src="$RSEL"
  pick_local "$(dl_dir)" folder || { warn "Batal."; return; }
  $ADB pull "$src" "$LSEL"
}

do_install_apk() {
  adb_ready || return
  pick_local "$(dl_dir)" file || { warn "Batal."; return; }
  local apk="$LSEL"
  case "$apk" in *.apk|*.APK) ;; *) err "File bukan .apk."; return ;; esac
  $ADB install -r "$apk"
}

menu_file() {
  while true; do
    banner "File & APK"
    echo " 1) Kirim file ke perangkat (push)"
    echo " 2) Ambil file dari perangkat (pull)"
    echo " 3) Install APK"
    echo " 0) Kembali"
    echo
    ask -p "Pilih: " c
    case "$c" in
      1) do_push; pause ;;
      2) do_pull; pause ;;
      3) do_install_apk; pause ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

# ---------- 3. Layar ----------
do_screenshot() {
  adb_ready || return
  local d f; d=$(outdir) || return; f="$d/screenshot-$(stamp).png"
  if $ADB exec-out screencap -p > "$f" 2>/dev/null && [ -s "$f" ]; then
    ok "Tersimpan: $f"
  else rm -f "$f"; err "Gagal ambil screenshot."; fi
}

do_screenrecord() {
  adb_ready || return
  local s d f
  ask -p "Durasi detik [30, maks 180]: " s; s=${s:-30}
  [[ "$s" =~ ^[0-9]+$ ]] && [ "$s" -ge 1 ] && [ "$s" -le 180 ] || { err "Durasi tidak valid."; return; }
  d=$(outdir) || return; f="$d/screenrecord-$(stamp).mp4"
  echo "Merekam $s detik..."
  $ADB shell screenrecord --time-limit "$s" /sdcard/af-rec.mp4
  if $ADB pull /sdcard/af-rec.mp4 "$f" >/dev/null 2>&1 && [ -s "$f" ]; then
    $ADB shell rm -f /sdcard/af-rec.mp4 >/dev/null 2>&1
    ok "Tersimpan: $f"
  else err "Gagal ambil rekaman."; fi
}

menu_layar() {
  while true; do
    banner "Layar"
    echo " 1) Screenshot"
    echo " 2) Rekam layar"
    echo " 0) Kembali"
    echo
    ask -p "Pilih: " c
    case "$c" in
      1) do_screenshot; pause ;;
      2) do_screenrecord; pause ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

# ---------- 4. Reboot (adaptif mode) ----------
do_reboot() { local label="$1"; shift; confirm "Reboot ke $label?" || { echo "Dibatalkan."; return; }; "$@"; sleep 1; }

menu_reboot() {
  while true; do
    banner "Reboot"
    case "$MODE" in
      adb|recovery|sideload)
        echo " 1) System   2) Recovery   3) Bootloader  4) FastbootD"
        echo " 5) Sideload 6) Download (Samsung)  7) EDL (Qualcomm)"
        echo " 0) Kembali"; echo
        ask -p "Pilih: " c
        case "$c" in
          1) do_reboot "System"      $ADB reboot ;;
          2) do_reboot "Recovery"    $ADB reboot recovery ;;
          3) do_reboot "Bootloader"  $ADB reboot bootloader ;;
          4) do_reboot "FastbootD"   $ADB reboot fastboot ;;
          5) do_reboot "Sideload"    $ADB reboot sideload ;;
          6) do_reboot "Download"    $ADB reboot download ;;
          7) do_reboot "EDL"         $ADB reboot edl ;;
          0) return ;;
          *) err "Pilihan tidak valid."; sleep 1 ;;
        esac ;;
      fastboot)
        echo " 1) System   2) Bootloader   3) Recovery   4) FastbootD"
        echo " 0) Kembali"; echo
        ask -p "Pilih: " c
        case "$c" in
          1) do_reboot "System"     $FB reboot ;;
          2) do_reboot "Bootloader" $FB reboot bootloader ;;
          3) do_reboot "Recovery"   $FB reboot recovery ;;
          4) do_reboot "FastbootD"  $FB reboot fastboot ;;
          0) return ;;
          *) err "Pilihan tidak valid."; sleep 1 ;;
        esac ;;
      *)
        warn "Tidak ada perangkat aktif."
        echo " R) Cek ulang   0) Kembali"; echo
        ask -p "Pilih: " c
        [ "$c" = 0 ] && return ;;
    esac
  done
}

# ---------- 5. Koneksi ----------
diagnose() {
  echo -e "${BOLD}Diagnosis USB${RESET}"; echo
  local c
  for c in termux-usb termux-adb termux-fastboot adb fastboot; do
    if command -v "$c" >/dev/null 2>&1; then echo -e " ${GREEN}✔${RESET} $c"; else echo -e " ${RED}✖${RESET} $c"; fi
  done
  echo
  if command -v termux-usb >/dev/null 2>&1; then
    local list; list=$(termux-usb -l 2>&1); echo "$list"
    if [ "$list" = "[]" ] || [ -z "$list" ]; then
      echo; warn "Tidak ada perangkat USB. Cek kabel data, OTG, dan cabut-pasang lalu jalankan lagi."
    fi
  else
    warn "termux-usb tidak ada. Pasang paket termux-api + aplikasi Termux:API."
  fi
  echo
  warn "Catatan: 'adb' biasa (android-tools) TIDAK bisa akses USB tanpa root —"
  warn "hanya berguna untuk ADB over WiFi. Untuk USB pakai termux-adb."
}

wifi_pair() {
  need_adb || return
  echo "Di target: Opsi pengembang > Debugging nirkabel > Pasangkan dengan kode."
  local hp code
  ask -p "IP:PORT pairing (mis. 192.168.1.5:37123): " hp
  [ -n "$hp" ] || { err "Kosong."; return; }
  ask -p "Kode pairing 6 digit: " code
  [ -n "$code" ] || { err "Kosong."; return; }
  if $ADB pair "$hp" "$code"; then
    ok "Pairing sukses. Lanjut connect dengan port dari layar Debugging nirkabel."
    confirm "Connect sekarang?" && wifi_connect
  fi
}

wifi_connect()   { need_adb || return; local hp; ask -p "IP:PORT koneksi: " hp; [ -n "$hp" ] && $ADB connect "$hp"; }
wifi_disconnect(){ need_adb || return; $ADB disconnect; }

wifi_tcpip() {
  adb_ready || return
  local ip
  ip=$($ADB shell "ip -f inet addr show wlan0" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}' | tr -d '\r')
  [ -n "$ip" ] || { err "IP WiFi tidak terbaca (WiFi aktif?)."; return; }
  confirm "Aktifkan ADB over WiFi di $ip:5555?" || return
  $ADB tcpip 5555 && sleep 1 && $ADB connect "$ip:5555"
  warn "Sekarang USB boleh dicabut (perangkat & Termux harus di WiFi yang sama)."
}

menu_koneksi() {
  while true; do
    banner "Koneksi"
    echo " 1) Diagnosis USB"
    echo " 2) ADB nirkabel: pairing"
    echo " 3) ADB nirkabel: connect"
    echo " 4) ADB nirkabel: disconnect"
    echo " 5) ADB via WiFi mode lama (tcpip, perlu USB dulu)"
    echo " 0) Kembali"
    echo
    ask -p "Pilih: " c
    case "$c" in
      1) diagnose; pause ;;
      2) wifi_pair; pause ;;
      3) wifi_connect; pause ;;
      4) wifi_disconnect; pause ;;
      5) wifi_tcpip; pause ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

# ---------- 6. Alat ----------
do_logcat() {
  adb_ready || return
  local d f; d=$(outdir) || return; f="$d/logcat-$(stamp).txt"
  $ADB logcat -d > "$f" 2>/dev/null && [ -s "$f" ] && ok "Tersimpan: $f" || { rm -f "$f"; err "Gagal simpan logcat."; }
}

do_crashlog() {
  adb_ready || return
  local d f; d=$(outdir) || return; f="$d/crash-$(stamp).txt"
  $ADB logcat -b crash -d > "$f" 2>/dev/null && [ -s "$f" ] && ok "Tersimpan: $f" || { rm -f "$f"; warn "Buffer crash kosong."; }
}

do_bugreport() {
  adb_ready || return
  local d f; d=$(outdir) || return; f="$d/bugreport-$(stamp).zip"
  warn "Butuh 1–3 menit, layar target jangan dikunci."
  $ADB bugreport "$f" && [ -s "$f" ] && ok "Tersimpan: $f" || err "Gagal bugreport."
}

do_report() {
  adb_ready || return
  local d f; d=$(outdir) || return; f="$d/laporan-$(stamp).txt"
  {
    echo "=== AF Termux — Laporan Perangkat ==="; date
    echo "--- getprop ---";   $ADB shell getprop
    echo "--- battery ---";   $ADB shell dumpsys battery
    echo "--- display ---";   $ADB shell wm size; $ADB shell wm density
    echo "--- storage ---";   $ADB shell df -h /data
    echo "--- meminfo ---";   $ADB shell head -5 /proc/meminfo
    echo "--- partisi ---";   $ADB shell "ls -l /dev/block/by-name/ 2>/dev/null"
    echo "--- kernel ---";    $ADB shell uname -a
  } > "$f" 2>/dev/null
  [ -s "$f" ] && ok "Tersimpan: $f" || { rm -f "$f"; err "Gagal buat laporan."; }
}

backup_keys() {
  local src="$HOME/.android"
  [ -f "$src/adbkey" ] || { warn "Kunci ADB belum ada. Jalankan ADB sekali dulu."; return; }
  local dest="$HOME"; [ -d "$HOME/storage/shared" ] && dest="$HOME/storage/shared"
  local file="$dest/adbkey-backup-$(stamp).tar.gz"
  tar -czf "$file" -C "$HOME" .android/adbkey .android/adbkey.pub 2>/dev/null \
    && { chmod 600 "$file" 2>/dev/null; ok "Backup: $file"; warn "Kunci ini RAHASIA, jangan dibagikan."; } \
    || err "Backup gagal."
}

menu_alat() {
  while true; do
    banner "Alat"
    echo " 1) Logcat (simpan)      4) Laporan perangkat"
    echo " 2) Log crash (simpan)   5) Backup kunci ADB"
    echo " 3) Bugreport (zip)      6) Shell ADB"
    echo " 0) Kembali"
    echo
    ask -p "Pilih: " c
    case "$c" in
      1) do_logcat; pause ;;
      2) do_crashlog; pause ;;
      3) do_bugreport; pause ;;
      4) do_report; pause ;;
      5) backup_keys; pause ;;
      6) adb_ready && { echo "Ketik 'exit' untuk keluar."; $ADB shell; }; pause ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

# ---------- 7. Advanced (flash — risiko) ----------
flash_part() { # $1 = nama partisi ("boot"/"recovery"/"dtbo"/"vendor_boot"/"custom")
  need_fb || return
  local part="$1"
  local base img size prod c
  if [ "$part" = custom ]; then
    ask -p "Nama partisi (mis. abl, xbl, vbmeta): " part
    [[ "$part" =~ ^[a-z0-9_]+$ ]] || { err "Nama partisi tidak valid."; return; }
  fi
  pick_local "$(dl_dir)" file || { warn "Batal."; return; }
  img="$LSEL"
  case "$img" in *.img|*.IMG|*.bin|*.BIN) ;; *) err "Bukan file .img/.bin."; return ;; esac
  size=$(stat -c%s "$img" 2>/dev/null || echo 0)
  prod=$($FB getvar product 2>&1 | tr -d '\r' | sed 's/^.*product: *//;s/^\(.*\)$/\1/;q')
  hr
  echo -e " Partisi : ${BOLD}${part}${RESET}"
  echo -e " Image   : $img ($(( size / 1048576 )) MB)"
  echo -e " Target  : ${prod:-fastboot device}"
  hr
  warn "MENULIS PARTISI BISA BOOTLOOP / BRICK."
  warn "Pastikan image benar-benar untuk perangkat ini. Tidak ada undo."
  confirm "Lanjut flash '$part'?" || { echo "Dibatalkan."; return; }
  ask -p "Ketik FLASH untuk konfirmasi terakhir: " c
  [ "$c" = "FLASH" ] || { echo "Dibatalkan."; return; }
  if $FB flash "$part" "$img"; then
    ok "Flash '$part' selesai."
    confirm "Reboot system sekarang?" && $FB reboot
  else
    err "Flash gagal — baca pesan di atas."
  fi
}

do_sideload() {
  need_adb || return
  pick_local "$(dl_dir)" file || { warn "Batal."; return; }
  local zip="$LSEL"
  case "$zip" in *.zip|*.ZIP) ;; *) err "Bukan file .zip (OTA)."; return ;; esac
  if [ "$MODE" != sideload ]; then
    warn "Perangkat akan di-reboot ke mode Sideload."
    confirm "Lanjut?" || return
    $ADB reboot sideload
    echo -n "Menunggu mode sideload"
    wait_mode sideload 60 || { err "Mode sideload tidak terdeteksi (recovery stok? cobakan custom recovery)."; return; }
    echo
  fi
  confirm "Kirim '$zip' via sideload?" || return
  $ADB sideload "$zip" && ok "Sideload selesai." || err "Sideload gagal."
}

menu_advanced() {
  while true; do
    banner "ADVANCED — Flash & Sideload"
    warn "Modul ini MENULIS partisi. Salah image = bootloop/brick."
    warn "Toolkit TIDAK menyediakan erase partisi."
    echo
    case "$MODE" in
      fastboot)
        echo " 1) Flash boot          4) Flash vendor_boot"
        echo " 2) Flash recovery      5) Flash partisi lain (custom)"
        echo " 3) Flash dtbo"
        echo " 0) Kembali"; echo
        ask -p "Pilih: " c
        case "$c" in
          1) flash_part boot ;;
          2) flash_part recovery ;;
          3) flash_part dtbo ;;
          4) flash_part vendor_boot ;;
          5) flash_part custom ;;
          0) return ;;
          *) err "Pilihan tidak valid."; sleep 1 ;;
        esac ;;
      adb|recovery|sideload)
        echo " 1) Sideload OTA (.zip)"
        echo " 0) Kembali"; echo
        ask -p "Pilih: " c
        case "$c" in
          1) do_sideload ;;
          0) return ;;
          *) err "Pilihan tidak valid."; sleep 1 ;;
        esac ;;
      *)
        warn "Butuh mode Fastboot atau ADB/Sideload."
        warn "Dari ADB: Reboot > Bootloader. Dari mati: Power+Vol bawah."
        echo " R) Cek ulang   0) Kembali"; echo
        ask -p "Pilih: " c
        [ "$c" = 0 ] && return ;;
    esac
  done
}

# ---------- 8. Pengaturan ----------
show_help() {
  cat <<'EOF'
BANTUAN
- Status perangkat diperbarui otomatis tiap layar terbuka; menu Perangkat > R untuk paksa.
- ADB: aktifkan USB debugging + setujui dialog di target (dan izin USB untuk Termux).
- Fastboot: target harus di mode bootloader.
- File picker: angka = pilih, 0 = naik folder, k = ketik manual, p = pakai folder.
- Modul Advanced menulis partisi (flash/sideload): konfirmasi ganda, TANPA erase.
- Fallback 'adb' (android-tools) hanya untuk ADB over WiFi, bukan USB.
EOF
}

show_about() {
  echo "AF Termux v$AF_VERSION — by lptech22"
  echo "Repo    : https://github.com/$AF_REPO"
  echo "Backend : nohajc/termux-adb"
  echo "ADB     : ${ADB:-tidak ada} $([ -n "$ADB" ] && $ADB --version 2>/dev/null | head -1)"
  echo "Fastboot: ${FB:-tidak ada} $([ -n "$FB" ] && $FB --version 2>/dev/null | head -1)"
}

do_update() {
  command -v curl >/dev/null 2>&1 || { err "curl tidak ada."; return 1; }
  local tmp newv target; tmp=$(mktemp) || return 1
  echo "Mengecek pembaruan..."
  curl -fsSL "$AF_RAW/af" -o "$tmp" || { err "Gagal unduh."; rm -f "$tmp"; return 1; }
  bash -n "$tmp" 2>/dev/null || { err "File tidak valid."; rm -f "$tmp"; return 1; }
  newv=$(grep -m1 '^AF_VERSION=' "$tmp" | cut -d'"' -f2)
  [ -n "$newv" ] || { err "Versi tak terbaca."; rm -f "$tmp"; return 1; }
  if [ "$newv" = "$AF_VERSION" ]; then ok "Sudah terbaru ($AF_VERSION)."; rm -f "$tmp"; return 0; fi
  confirm "Perbarui $AF_VERSION -> $newv?" || { echo "Dibatalkan."; rm -f "$tmp"; return 0; }
  target="$PREFIX/bin/af"
  cp "$tmp" "$target.new" && chmod +x "$target.new" && mv -f "$target.new" "$target" \
    && ln -sf af "$PREFIX/bin/adb-fb" 2>/dev/null \
    && ok "Terbaru: $newv. Jalankan 'af' lagi." || err "Gagal pasang."
  rm -f "$tmp"
}

do_uninstall() {
  echo "Menghapus perintah 'af' dan 'adb-fb'."
  confirm "Lanjut?" || { echo "Dibatalkan."; return 1; }
  rm -f "$PREFIX/bin/af" "$PREFIX/bin/adb-fb"
  confirm "Hapus juga backend termux-adb/termux-fastboot?" && \
    rm -f "$PREFIX/bin/termux-adb" "$PREFIX/bin/termux-fastboot"
  ok "Selesai."
}

menu_pengaturan() {
  while true; do
    banner "Pengaturan"
    echo " 1) Bantuan        3) Perbarui toolkit"
    echo " 2) Tentang        4) Hapus toolkit"
    echo " 0) Kembali"
    echo
    ask -p "Pilih: " c
    case "$c" in
      1) show_help; pause ;;
      2) show_about; pause ;;
      3) do_update && pause ;;
      4) do_uninstall && exit 0 ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

# ---------- argumen ----------
case "${1:-}" in
  -v|--version|version) echo "AF Termux $AF_VERSION"; exit 0 ;;
  -h|--help|help)       usage; exit 0 ;;
  info)                 detect_mode; case "$MODE" in adb|recovery|sideload) info_adb ;; fastboot) info_fastboot ;; *) echo "Tidak ada perangkat." ;; esac; exit 0 ;;
  update)               do_update; exit $? ;;
  uninstall)            do_uninstall; exit $? ;;
  "") ;;
  *) echo "Perintah tidak dikenal: $1"; echo; usage; exit 1 ;;
esac

usage() {
  cat <<EOF
AF Termux v$AF_VERSION — ADB & Fastboot lewat Termux
  af            menu utama
  af info       info perangkat cepat
  af update     perbarui toolkit
  af uninstall  hapus toolkit
  af --version / --help
EOF
}

