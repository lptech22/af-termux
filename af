#!/data/data/com.termux/files/usr/bin/bash
# AF Termux — ROM Flash Mode (Fastboot & ADB Sideload)
# v2.0.0 · by lptech22 · https://github.com/lptech22/af-termux
# Tidak ada erase partisi. Setiap perintah ditampilkan dulu, lalu dikonfirmasi.

AF_VERSION="2.0.0"
AF_REPO="lptech22/af-termux"
AF_RAW="https://raw.githubusercontent.com/$AF_REPO/main"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

GREEN="\033[32m"; RED="\033[31m"; YELLOW="\033[33m"; CYAN="\033[36m"; BOLD="\033[1m"; DIM="\033[2m"; RESET="\033[0m"

if command -v termux-adb >/dev/null 2>&1; then ADB="termux-adb"; elif command -v adb >/dev/null 2>&1; then ADB="adb"; else ADB=""; fi
if command -v termux-fastboot >/dev/null 2>&1; then FB="termux-fastboot"; elif command -v fastboot >/dev/null 2>&1; then FB="fastboot"; else FB=""; fi

MODE=""; SERIAL=""; INFO=""
trap 'echo; err "Dibatalkan."; exit 130' INT

# ---------- helper ----------
ask()     { read -r "$@" || { echo; err "Input ditutup."; exit 0; }; }
pause()   { echo; ask -p "Tekan Enter untuk lanjut..." _; }
confirm() { local c; ask -p "$1 [y/N]: " c; [[ "$c" =~ ^[Yy]$ ]]; }
expand()  { local p="$1"; echo "${p/#\~/$HOME}"; }
ok()      { echo -e "${GREEN}✔${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET} $*"; }
err()     { echo -e "${RED}✖${RESET} $*"; }
hr()      { echo -e "${DIM}────────────────────────────────────────────────${RESET}"; }
need_adb() { [ -n "$ADB" ] || { err "Backend ADB tidak ada. Jalankan ulang installer."; return 1; }; }
need_fb()  { [ -n "$FB" ]  || { err "Backend Fastboot tidak ada. Jalankan ulang installer."; return 1; }; }
stamp()    { date +%Y%m%d-%H%M%S; }

ensure_storage() {
  [ -d "$HOME/storage/shared" ] && return 0
  warn "Penyimpanan bersama belum aktif (folder Download tidak terlihat)."
  confirm "Minta izin sekarang (termux-setup-storage)?" && { termux-setup-storage; sleep 2; }
  [ -d "$HOME/storage/shared" ] && { ok "Penyimpanan siap."; return 0; }
  err "Gagal. Jalankan manual: termux-setup-storage"; return 1
}

dl_dir() { local d="$HOME/storage/shared/Download"; [ -d "$d" ] && echo "$d" || echo "$PWD"; }

# ---------- deteksi mode (dari fastboot devices / adb devices) ----------
detect_mode() {
  MODE=""; SERIAL=""; INFO=""
  if [ -n "$FB" ]; then
    local line
    line=$($FB devices 2>/dev/null | grep . | head -1)
    if [ -n "$line" ]; then
      MODE="fastboot"; SERIAL=${line%%[[:space:]]*}
      INFO=$($FB getvar product 2>&1 | tr -d '\r' | sed -n 's/^.*product: *//p' | head -1)
      return 0
    fi
  fi
  [ -n "$ADB" ] || return 0
  local line st
  line=$($ADB devices 2>/dev/null | awk 'NR>1 && NF>1 {print $1" "$2}' | head -1)
  st=${line#* }; SERIAL=${line%% *}
  case "$st" in
    device)       MODE="adb"; INFO=$($ADB shell getprop ro.product.model 2>/dev/null | tr -d '\r') ;;
    sideload)     MODE="sideload" ;;
    recovery)     MODE="recovery" ;;
    unauthorized) MODE="unauthorized" ;;
    offline)      MODE="offline" ;;
    *)            SERIAL="" ;;
  esac
}

badge() {
  case "$MODE" in
    fastboot)     echo -e "${YELLOW}● Fastboot${RESET} ${DIM}${SERIAL}${INFO:+ · $INFO}${RESET}" ;;
    adb)          echo -e "${GREEN}● ADB${RESET} ${DIM}${SERIAL}${INFO:+ · $INFO}${RESET}" ;;
    sideload)     echo -e "${CYAN}● ADB Sideload${RESET} ${DIM}${SERIAL}${RESET}" ;;
    recovery)     echo -e "${CYAN}● Recovery (ADB)${RESET} ${DIM}${SERIAL}${RESET}" ;;
    unauthorized) echo -e "${RED}● ADB — setujui dialog izin di target${RESET}" ;;
    offline)      echo -e "${RED}● ADB — offline${RESET}" ;;
    *)            echo -e "${RED}○ Tidak ada perangkat${RESET}" ;;
  esac
}

banner() {
  clear
  echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  echo -e " ${BOLD}AF TERMUX${RESET} ${YELLOW}v$AF_VERSION${RESET} ${DIM}· ROM Flash Mode · lptech22${RESET}"
  echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
  detect_mode
  echo -e " Mode: $(badge)"
  echo
  [ -n "$1" ] && { echo -e "${BOLD}▶ $1${RESET}"; echo; }
}

wait_mode() { # wait_mode <mode> <timeout>
  local want="$1" t="${2:-60}" i
  for ((i=0; i<t; i++)); do
    detect_mode
    [ "$MODE" = "$want" ] && return 0
    sleep 1; printf "."
  done
  echo; return 1
}

# tampil perintah → konfirmasi → eksekusi
run_cmd() { # run_cmd <tampilan> <ketik-atau-kosong> <perintah...>
  local disp="$1" typed="$2"; shift 2
  echo; hr
  echo -e " ${BOLD}\$ $disp${RESET}"
  hr
  if [ -n "$typed" ]; then
    local c; ask -p "Ketik ${BOLD}$typed${RESET} untuk eksekusi: " c
    [ "$c" = "$typed" ] || { echo "Dibatalkan."; return 1; }
  else
    confirm "Eksekusi?" || { echo "Dibatalkan."; return 1; }
  fi
  "$@"
}

# ---------- file picker ----------
pick_local() { # $1=start-dir → hasil di LSEL
  local dir="${1:-$(dl_dir)}" c sel n
  while true; do
    [ -d "$dir" ] || dir="$HOME"
    local items=(); n=1
    echo; echo -e "${BOLD}📁${RESET} $dir"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      items+=("$f"); printf " %2d) %s\n" "$n" "$f"; n=$((n+1))
    done < <(ls -1Ap "$dir" 2>/dev/null | head -300)
    [ "${#items[@]}" -eq 0 ] && warn "(folder kosong)"
    echo -e " 0) ../ naik   k) ketik path   q) batal"
    ask -p "Pilih file: " c
    case "$c" in
      0) dir=$(dirname "$dir") ;;
      q|Q) return 1 ;;
      k|K) ask -e -p "Path: " dir; dir=$(expand "$dir") ;;
      *)
        if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le "${#items[@]}" ]; then
          sel="${items[$((c-1))]}"
          case "$sel" in
            */) dir="${dir%/}/${sel%/}" ;;
            *)  LSEL="${dir%/}/$sel"; return 0 ;;
          esac
        else err "Pilihan tidak valid."; fi
        ;;
    esac
  done
}

# ---------- 1) FASTBOOT ----------
fb_flash() {
  local img="$1" p flags="" mb
  mb=$(( $(stat -c%s "$img" 2>/dev/null || echo 0) / 1048576 ))
  echo; echo " Pilih partisi:"
  echo "  1) boot   2) dtbo   3) vbmeta   4) vendor_boot   5) recovery   6) custom"
  ask -p "Partisi: " p
  case "$p" in
    1) p=boot ;; 2) p=dtbo ;; 3) p=vbmeta ;; 4) p=vendor_boot ;; 5) p=recovery ;;
    6) ask -p "Nama partisi: " p; [[ "$p" =~ ^[a-z0-9_]+$ ]] || { err "Nama tidak valid."; return; } ;;
    *) echo "Batal."; return ;;
  esac
  [ "$p" = vbmeta ] && confirm "Tambah --disable-verity --disable-verification (umum untuk custom ROM)?" \
    && flags="--disable-verity --disable-verification"
  echo -e " ${DIM}File: $img${INFO:+ · $INFO} (${mb} MB)${RESET}"
  run_cmd "fastboot flash $p $img $flags" FLASH $FB flash "$p" "$img" $flags \
    && ok "Flash '$p' selesai."
}

fastboot_menu() {
  need_fb || return
  while true; do
    banner "Fastboot"
    if [ "$MODE" != fastboot ]; then
      if [ "$MODE" = adb ]; then
        confirm "Target sedang ADB. Reboot ke Bootloader sekarang?" && {
          $ADB reboot bootloader
          echo -n "Menunggu fastboot"; wait_mode fastboot 60; echo
        }
      else
        warn "Tidak ada perangkat Fastboot."
        warn "Masuk mode fastboot: matikan HP → tahan Power + Vol bawah."
      fi
      echo " R) Cek ulang   0) Kembali"; echo
      ask -p "Pilih: " c
      [ "$c" = 0 ] && return
      continue
    fi
    pick_local "$(dl_dir)" || { warn "Batal."; return; }
    local img="$LSEL"
    echo; echo -e " File: ${BOLD}${img}${RESET}"
    echo " Aksi:  1) flash (tulis partisi)   2) boot (boot sementara, aman)   3) custom argumen   0) batal"
    ask -p "Aksi: " a
    case "$a" in
      1) fb_flash "$img" ;;
      2) run_cmd "fastboot boot $img" "" $FB boot "$img" && ok "Boot sementara terkirim." ;;
      3) local args
         ask -p "Argumen fastboot (tanpa kata 'fastboot'): " args
         [ -n "$args" ] && run_cmd "fastboot $args" "" $FB $args ;;
      0) return ;;
      *) err "Pilihan tidak valid." ;;
    esac
    pause
  done
}

# ---------- 2) ADB SIDELOAD ----------
sideload_menu() {
  need_adb || return
  while true; do
    banner "ADB Sideload"
    case "$MODE" in
      sideload) break ;;
      adb)
        confirm "Target sedang ADB. Reboot ke mode Sideload?" || return
        $ADB reboot sideload
        echo -n "Menunggu mode sideload"; wait_mode sideload 60; echo
        [ "$MODE" = sideload ] && break || { err "Mode sideload tidak terdeteksi."; pause; return; } ;;
      recovery)
        warn "Di recovery target, pilih 'Apply update from ADB' dulu."
        echo " R) Cek ulang   0) Kembali"; echo
        ask -p "Pilih: " c
        [ "$c" = 0 ] && return
        continue ;;
      unauthorized) err "Target belum menyetujui debugging USB (unauthorized)."; pause; return ;;
      *)
        warn "Tidak ada perangkat ADB."
        warn "Masuk sideload: recovery target > Apply update from ADB."
        echo " R) Cek ulang   0) Kembali"; echo
        ask -p "Pilih: " c
        [ "$c" = 0 ] && return
        continue ;;
    esac
  done
  ensure_storage || return
  pick_local "$(dl_dir)" || { warn "Batal."; return; }
  local zip="$LSEL"
  case "$zip" in *.zip|*.ZIP) ;; *) err "Bukan file .zip."; return ;; esac
  warn "Sideload menulis sistem — jangan sentuh HP sampai selesai (bisa 5-15 menit)."
  run_cmd "adb sideload $zip" "" $ADB sideload "$zip" \
    && ok "Sideload selesai. Target biasanya reboot sendiri."
  pause
  return
}

# ---------- 3) CUSTOM ----------
reboot_menu() {
  case "$MODE" in
    adb|recovery|sideload)
      echo " 1) System   2) Recovery   3) Bootloader   4) Sideload   0) batal"
      ask -p "Pilih: " r
      case "$r" in
        1) $ADB reboot ;; 2) $ADB reboot recovery ;;
        3) $ADB reboot bootloader ;; 4) $ADB reboot sideload ;;
      esac ;;
    fastboot)
      echo " 1) System   2) Bootloader   3) Recovery   4) FastbootD   0) batal"
      ask -p "Pilih: " r
      case "$r" in
        1) $FB reboot ;; 2) $FB reboot bootloader ;;
        3) $FB reboot recovery ;; 4) $FB reboot fastboot ;;
      esac ;;
    *) warn "Tidak ada perangkat." ;;
  esac
}

custom_menu() {
  local a
  while true; do
    banner "Custom Perintah"
    echo " 1) Perintah adb      (mis: devices, reboot recovery, shell)"
    echo " 2) Perintah fastboot (mis: getvar all, set_active a)"
    echo " 3) Reboot target"
    echo " 4) Cek perangkat (adb devices + fastboot devices)"
    echo " 0) Kembali"; echo
    ask -p "Pilih: " c
    case "$c" in
      1) need_adb || continue
         ask -p "Argumen adb (tanpa kata 'adb'): " a
         [ -n "$a" ] && run_cmd "adb $a" "" $ADB $a ;;
      2) need_fb || continue
         ask -p "Argumen fastboot (tanpa kata 'fastboot'): " a
         [ -n "$a" ] && run_cmd "fastboot $a" "" $FB $a ;;
      3) reboot_menu ;;
      4) [ -n "$ADB" ] && $ADB devices -l; [ -n "$FB" ] && $FB devices; pause ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

# ---------- 4) ADVANCED ----------
show_info() {
  echo "AF Termux v$AF_VERSION — ROM Flash Mode"
  echo "Repo    : https://github.com/$AF_REPO"
  echo "Backend : nohajc/termux-adb"
  echo "ADB     : ${ADB:-tidak ada} $([ -n "$ADB" ] && $ADB --version 2>/dev/null | head -1)"
  echo "Fastboot: ${FB:-tidak ada} $([ -n "$FB" ] && $FB --version 2>/dev/null | head -1)"
}

do_update() {
  command -v curl >/dev/null 2>&1 || { err "curl tidak ada."; return 1; }
  local tmp newv target; tmp=$(mktemp) || return 1
  echo "Mengecek pembaruan..."
  curl -fsSL "$AF_RAW/af" -o "$tmp" || { err "Gagal unduh."; rm -f "$tmp"; return 1; }
  bash -n "$tmp" 2>/dev/null || { err "File tidak valid."; rm -f "$tmp"; return 1; }
  newv=$(grep -m1 '^AF_VERSION=' "$tmp" | cut -d'"' -f2)
  [ -n "$newv" ] || { err "Versi tak terbaca."; rm -f "$tmp"; return 1; }
  if [ "$newv" = "$AF_VERSION" ]; then ok "Sudah terbaru ($AF_VERSION)."; rm -f "$tmp"; return 0; fi
  confirm "Perbarui $AF_VERSION -> $newv?" || { echo "Dibatalkan."; rm -f "$tmp"; return 0; }
  target="$PREFIX/bin/af"
  cp "$tmp" "$target.new" && chmod +x "$target.new" && mv -f "$target.new" "$target" \
    && ln -sf af "$PREFIX/bin/adb-fb" 2>/dev/null \
    && ok "Terbaru: $newv. Jalankan 'af' lagi." || err "Gagal pasang."
  rm -f "$tmp"
}

do_uninstall() {
  echo "Menghapus perintah 'af' dan 'adb-fb'."
  confirm "Lanjut?" || { echo "Dibatalkan."; return 1; }
  rm -f "$PREFIX/bin/af" "$PREFIX/bin/adb-fb"
  confirm "Hapus juga backend termux-adb/termux-fastboot?" && \
    rm -f "$PREFIX/bin/termux-adb" "$PREFIX/bin/termux-fastboot"
  ok "Selesai."
}

advanced_menu() {
  while true; do
    banner "Advanced"
    echo " 1) Info tools & backend"
    echo " 2) Update toolkit"
    echo " 3) Uninstall toolkit"
    echo " 0) Kembali"; echo
    ask -p "Pilih: " c
    case "$c" in
      1) show_info; pause ;;
      2) do_update && pause ;;
      3) do_uninstall && exit 0 ;;
      0) return ;;
      *) err "Pilihan tidak valid."; sleep 1 ;;
    esac
  done
}

usage() {
  cat <<EOF
AF Termux v$AF_VERSION — ROM Flash Mode
  af            menu utama
  af update     perbarui toolkit
  af uninstall  hapus toolkit
  af --version / --help
EOF
}

# ---------- argumen ----------
case "${1:-}" in
  -v|--version|version) echo "AF Termux $AF_VERSION"; exit 0 ;;
  -h|--help|help)       usage; exit 0 ;;
  update)               do_update; exit $? ;;
  uninstall)            do_uninstall; exit $? ;;
  "") ;;
  *) echo "Perintah tidak dikenal: $1"; echo; usage; exit 1 ;;
esac

# ---------- menu utama ----------
while true; do
  banner
  echo " 1) Fastboot       flash boot/dtbo/vbmeta/vendor_boot, boot img"
  echo " 2) ADB Sideload   kirim .zip ROM/GApps ke recovery"
  echo " 3) Custom         perintah adb/fastboot bebas, reboot"
  echo " 4) Advanced       info, update, uninstall"
  echo " 0) Keluar"
  echo
  ask -p "Pilih menu: " choice
  case "$choice" in
    1) fastboot_menu ;;
    2) sideload_menu ;;
    3) custom_menu ;;
    4) advanced_menu ;;
    0|q|Q) echo "Sampai jumpa."; exit 0 ;;
    *) err "Pilihan tidak valid."; sleep 1 ;;
  esac
done
